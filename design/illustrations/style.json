{
  "format": "waldpost-illustration-style",
  "version": 1,
  "id": "waldpost-watercolour-pencil-v1",
  "canonicalGuide": "design/illustrations/STYLE.md",
  "date": "2026-11-16",
  "basedOn": "3fff5b516fa9b0c9a22baa2aeae389d7a251ad34",
  "styleBlock": "design/illustrations/STYLE.txt",
  "styleBlockSha256": "2a00ce3fe3e14c55cae91fd86b9066da2ef13eab68017e23d86f92859ecf82ca",
  "framingGuidance": "Compare related pictures side by side at the size used in the game. For square cells, draw the complete silhouette with enough transparent space to pack it centred on both axes, with its longest visible side about 80% of the cell. Keep its proportions and use comparable visual weight for neighbouring answers. Reuse the same painting when a subject and pose recur. Leave genuine alpha around every isolated subject and retain the soft pencil edges. Inspect on light and dark backgrounds for pale matte, clipped outlines, stray pixels and neighbouring subjects. In a cell repair, preserve the pixels and positions of the other cells. Scenes and irregular layouts follow their role and brief.",
  "references": [
    {
      "path": "design/illustrations/references/watercolour-pencil-v1/animals.png",
      "sha256": "65867082294d157ab4ffbe33926857272625ef3c25cdb7cab81c2a4ea73d9316",
      "purpose": "canonical drawing technique for animals; fixed majority-style pixels",
      "usage": "canonical-style"
    },
    {
      "path": "design/illustrations/references/watercolour-pencil-v1/objects.png",
      "sha256": "0bb37d6fc82c75034eddf30da2cc57c546dd8bc70d246aeeda85b637bd87dd80",
      "purpose": "canonical drawing technique for objects, leaves and flowers; fixed majority-style pixels",
      "usage": "canonical-style"
    }
  ],
  "roles": {
    "learning": {
      "instruction": "Match the canonical watercolour and coloured-pencil technique closely: fine organic contours, uneven washes and gentle drawn volume. Keep accurate species, action contrasts, one counted object per item and exact answer colours. Use transparent square cells, generous gutters and complete silhouettes."
    },
    "navigation": {
      "instruction": "Use the same warm hand-drawn palette as a SIMPLE small pictogram. Follow the approved navigation-symbol reference for broad, softly irregular sepia outlines, rounded bold silhouettes and nearly flat fills. Match its illustrated edge softness and outline-to-fill proportions. Omit tiny scenery, stamps, material grain, fine hatching, glossy hubs and extra decoration. It must read at 32 pixels. This is a prescribed low-detail application of the canonical style. The den exit and navigation back belong to this same illustrated family as settings, map and letter. The map home marker uses its separate painted map-landmark role. Reuse current assets rather than rigid geometric substitutes or the retired detailed wooden pins.",
      "references": [
        {
          "path": "assets/interface/navigation-symbols.webp",
          "sha256": "f9c7c6974bd023d60a6510ea60ef5e4f4fa2537c0da853f077fc8b5c050bd0f4",
          "purpose": "approved simplicity and silhouette reference for navigation; not a material-realism reference",
          "usage": "navigation-simplicity"
        }
      ]
    },
    "stationery": {
      "instruction": "Apply the canonical drawing technique to pale cream paper with restrained pencil borders and small leaf details. Keep clean empty space for the separately painted sender portrait. Genuine transparency surrounds the whole paper. Do not generate a substitute character or paint interface controls into the asset."
    },
    "scene": {
      "instruction": "Apply the canonical watercolour/pencil medium at landscape scale: broad quiet washes, restrained drawn detail at the edges, matte natural colours and soft organic contours. The scene is opaque. Keep the centre pale and calm for real panels and preserve required camera/layout anchors. Existing scene references define composition only; the canonical pair defines technique. Do not paint UI panels, text or characters into backgrounds."
    },
    "branding": {
      "instruction": "Use the canonical warm illustrated technique as a simple readable app emblem. Keep a clear silhouette and quiet background. A branding fox is not a replacement for the existing puzzle/map model portraits or the painted letter sender portraits."
    },
    "letter-portrait": {
      "instruction": "Paint recognizable sender friends in the canonical watercolour and coloured-pencil medium, with natural friendly animal proportions, organic sepia contours and gentle drawn volume. Keep species markings and identity accessories readable, with genuine transparency and complete silhouettes in generous square cells. Any model reference defines identity and colour only, never rendering style. This fourteen-animal base supplies the shared painted cast; a matching sleeping fox completes the common UI atlas. The live world retains its 3D model pipeline."
    },
    "cartography": {
      "instruction": "Apply the canonical watercolour/pencil medium as a simplified flat cartographic plan. Strict orthographic top-down projection throughout, no perspective, visible vertical surfaces, relief modelling or cast shadows. Use broad quiet colour regions, light washes, fine organic sepia outlines and a few small plan-view symbols. Keep path connections, water boundaries and relative landmark positions clear; remove decorative microdetail. Opaque landscape canvas. Geography references define layout only. Keep runtime-approved geography calibrated to the actual interface; new proposals stay separate until the owner approves them."
    },
    "character": {
      "instruction": "Use the canonical watercolour-and-coloured-pencil medium for the shared game-character portraits on letters, map pins, puzzle pages, menus, companions and celebrations. Reuse the approved painted identities, natural friendly proportions, species markings and accessories. Complete silhouettes, real transparency and generous square-cell margins. Keep the live 3D world as its own model pipeline; do not substitute these identity portraits for scored learning pictures."
    },
    "map-landmark": {
      "instruction": "Use the canonical watercolour-and-coloured-pencil medium for a single map destination landmark, matching the painted character portraits in finish and detail. Keep the silhouette compact and recognizable at 40–50 pixels, with broad simple forms, organic sepia contours, gentle washes and restrained pencil shading. Genuine transparency, generous square padding and complete edges. No miniature realistic scenery or material microdetail. Actual map buttons, names and click behaviour remain code."
    }
  },
